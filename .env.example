# ==============================================================================
# ALMARTE ARTESANOS — Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo a `.env` y configura tus valores correspondientes.

# ------------------------------------------------------------------------------
# Base de Datos (MariaDB / MySQL)
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://usuario:password@127.0.0.1:3306/almarte"

# ------------------------------------------------------------------------------
# Autenticación y Cifrado
# ------------------------------------------------------------------------------
# Genera una clave segura de mínimo 32 caracteres
JWT_SECRET="almarte_super_secret_jwt_key_min_32_chars!"

# ------------------------------------------------------------------------------
# Multimedia & Almacenamiento (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# ------------------------------------------------------------------------------
# Pasarela de Pagos Wompi (Bancolombia)
# ------------------------------------------------------------------------------
# Para desarrollo/pruebas usa el Sandbox (prefijos pub_test_, prv_test_, test_integrity_, test_events_)
# Obtén tus llaves en: https://comercios.wompi.co/ (Sección Desarrolladores)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_test_..."
WOMPI_PRIVATE_KEY="prv_test_..."
WOMPI_INTEGRITY_SECRET="test_integrity_..."
WOMPI_EVENTS_SECRET="test_events_..."

# URL base de la aplicación (para redirecciones de pago)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
